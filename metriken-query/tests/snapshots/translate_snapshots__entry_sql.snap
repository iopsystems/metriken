=========================
counter_irate_total_per_cpu_core_pct
=========================
WITH rates AS (
  SELECT timestamp,
    irate_lag("cpu_usage/user/0", LAG("cpu_usage/user/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("cpu_usage/system/0", LAG("cpu_usage/system/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1,
    irate_lag("cpu_usage/softirq/0", LAG("cpu_usage/softirq/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_2,
    irate_lag("cpu_usage/irq/0", LAG("cpu_usage/irq/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_3,
    irate_lag("cpu_usage/user/1", LAG("cpu_usage/user/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_4,
    irate_lag("cpu_usage/system/1", LAG("cpu_usage/system/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_5,
    irate_lag("cpu_usage/softirq/1", LAG("cpu_usage/softirq/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_6,
    irate_lag("cpu_usage/irq/1", LAG("cpu_usage/irq/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_7,
    CAST("cpu_cores" AS DOUBLE) AS cores
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
)
SELECT CAST(timestamp AS DOUBLE) / 1e9 AS t, ((COALESCE(val_0, 0) + COALESCE(val_1, 0) + COALESCE(val_2, 0) + COALESCE(val_3, 0) + COALESCE(val_4, 0) + COALESCE(val_5, 0) + COALESCE(val_6, 0) + COALESCE(val_7, 0)) / NULLIF(cores, 0)) / 1000000000 AS v FROM rates WHERE val_0 IS NOT NULL OR val_1 IS NOT NULL OR val_2 IS NOT NULL OR val_3 IS NOT NULL OR val_4 IS NOT NULL OR val_5 IS NOT NULL OR val_6 IS NOT NULL OR val_7 IS NOT NULL

