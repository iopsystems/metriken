---
source: metriken-query/tests/translate_snapshots.rs
expression: combined
---

=========================
counter_irate_basic
=========================
WITH rates AS (
  SELECT timestamp,
    irate_lag("requests", LAG("requests") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
)
SELECT CAST(timestamp AS DOUBLE) / 1e9 AS t, v AS v
FROM (
      SELECT timestamp, val_0 AS v FROM rates
) per_series


=========================
counter_irate_by_g_with_labels
=========================
WITH rates AS (
  SELECT timestamp,
    irate_lag("softirq/hi/0", LAG("softirq/hi/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("softirq/timer/0", LAG("softirq/timer/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1,
    irate_lag("softirq/net_rx/0", LAG("softirq/net_rx/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_2
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
)
SELECT CAST(timestamp AS DOUBLE) / 1e9 AS t, ((COALESCE(val_0, 0))) AS v, 'hi' AS "kind" FROM rates WHERE val_0 IS NOT NULL
      UNION ALL
      SELECT CAST(timestamp AS DOUBLE) / 1e9 AS t, ((COALESCE(val_2, 0))) AS v, 'net_rx' AS "kind" FROM rates WHERE val_2 IS NOT NULL
      UNION ALL
      SELECT CAST(timestamp AS DOUBLE) / 1e9 AS t, ((COALESCE(val_1, 0))) AS v, 'timer' AS "kind" FROM rates WHERE val_1 IS NOT NULL

