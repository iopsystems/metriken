  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
a_summed AS (
      SELECT timestamp, (COALESCE(val_0, 0)) AS v, '0' AS "id" FROM a_rates WHERE val_0 IS NOT NULL
      UNION ALL
      SELECT timestamp, (COALESCE(val_1, 0)) AS v, '1' AS "id" FROM a_rates WHERE val_1 IS NOT NULL
),
b_rates AS (
  SELECT timestamp,
    irate_lag("cpu_cycles/0", LAG("cpu_cycles/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("cpu_cycles/1", LAG("cpu_cycles/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1
  FROM _src
