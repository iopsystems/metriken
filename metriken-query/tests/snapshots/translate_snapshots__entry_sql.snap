    irate_lag("softirq/net_rx/0", LAG("softirq/net_rx/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_2
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
)
SELECT CAST(timestamp AS DOUBLE) / 1e9 AS t, ((COALESCE(val_0, 0))) / 1000 AS v, 'hi' AS "kind" FROM rates WHERE val_0 IS NOT NULL
      UNION ALL
      SELECT CAST(timestamp AS DOUBLE) / 1e9 AS t, ((COALESCE(val_2, 0))) / 1000 AS v, 'net_rx' AS "kind" FROM rates WHERE val_2 IS NOT NULL
      UNION ALL
      SELECT CAST(timestamp AS DOUBLE) / 1e9 AS t, ((COALESCE(val_1, 0))) / 1000 AS v, 'timer' AS "kind" FROM rates WHERE val_1 IS NOT NULL

