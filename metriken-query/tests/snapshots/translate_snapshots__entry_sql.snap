=========================
counter_rate_bare_generic
=========================
WITH per_pair AS (
  SELECT timestamp,
    irate_lag("requests", LAG("requests") OVER w, timestamp - LAG(timestamp) OVER w) AS inc_0,
    CASE WHEN "requests" IS NOT NULL THEN timestamp END AS t_first_0
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
rates AS (
  SELECT timestamp,
    (SUM(inc_0) OVER w - COALESCE(FIRST_VALUE(inc_0) OVER w, 0)) / NULLIF(CAST(timestamp - MIN(t_first_0) OVER w AS DOUBLE) / 1e9, 0) AS val_0
  FROM per_pair
  WINDOW w AS (ORDER BY timestamp RANGE BETWEEN 300000000000 PRECEDING AND CURRENT ROW)
)
SELECT CAST(timestamp AS DOUBLE) / 1e9 AS t, v AS v
FROM (
      SELECT timestamp, val_0 AS v FROM rates
) per_series


