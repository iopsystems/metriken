=========================
counter_irate_ratio_with_labels
=========================
WITH rates AS (
  SELECT timestamp,
    irate_lag("softirq_time/hi/0", LAG("softirq_time/hi/0") OVER w, timestamp - LAG(timestamp) OVER w) AS a_0,
    irate_lag("softirq_time/hi/1", LAG("softirq_time/hi/1") OVER w, timestamp - LAG(timestamp) OVER w) AS a_1,
    irate_lag("softirq/hi/0", LAG("softirq/hi/0") OVER w, timestamp - LAG(timestamp) OVER w) AS b_0,
    irate_lag("softirq/hi/1", LAG("softirq/hi/1") OVER w, timestamp - LAG(timestamp) OVER w) AS b_1
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
)
SELECT CAST(timestamp AS DOUBLE) / 1e9 AS t, ((CASE WHEN a_0 IS NOT NULL OR a_1 IS NOT NULL THEN (COALESCE(a_0, 0) + COALESCE(a_1, 0)) END) / NULLIF((CASE WHEN b_0 IS NOT NULL OR b_1 IS NOT NULL THEN (COALESCE(b_0, 0) + COALESCE(b_1, 0)) END), 0)) AS v
FROM rates

