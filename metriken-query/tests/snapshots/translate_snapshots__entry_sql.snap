histogram_quantile_with_reset
=========================
WITH combined AS (
  SELECT timestamp, "request_latency:buckets" AS buckets, ROW_NUMBER() OVER (ORDER BY timestamp) AS rn FROM _src
),
per_tick AS (
  SELECT a.timestamp, h2_delta(a.buckets, b.buckets) AS d
  FROM combined a LEFT JOIN combined b ON b.rn = a.rn - 1
)
SELECT t, v FROM (
  SELECT CAST(timestamp AS DOUBLE) / 1e9 AS t, CAST(h2_quantile(d, 0.5, 3) AS DOUBLE) AS v
  FROM per_tick
)
WHERE v IS NOT NULL
ORDER BY t

=========================
histogram_quantiles_rezolus_ext
=========================
WITH combined AS (
  SELECT timestamp, "request_latency:buckets" AS buckets, ROW_NUMBER() OVER (ORDER BY timestamp) AS rn FROM _src
),
walked AS (
  SELECT a.timestamp, h2_quantiles(h2_delta(a.buckets, b.buckets), [0.5, 0.9, 0.99]::DOUBLE[], 3) AS qs
  FROM combined a LEFT JOIN combined b ON b.rn = a.rn - 1
)
SELECT CAST(timestamp AS DOUBLE) / 1e9 AS t, CAST(qs[q.idx] AS DOUBLE) AS v, q.label AS quantile
FROM walked CROSS JOIN (VALUES (1, '0.5'), (2, '0.9'), (3, '0.99')) AS q(idx, label)
ORDER BY quantile, t

=========================
memory_util_pct
=========================
SELECT CAST(timestamp AS DOUBLE) / 1e9 AS t, (CAST("memory_total" AS DOUBLE) - CAST("memory_available" AS DOUBLE)) / NULLIF(CAST("memory_total" AS DOUBLE), 0) AS v FROM _src WHERE "memory_total" IS NOT NULL AND "memory_available" IS NOT NULL

=========================
rezolus_bpf_avg_run_time_per_sampler
=========================
WITH
a_rates AS (
  SELECT timestamp,
    irate_lag("rezolus_bpf_run_time/cpu/usage", LAG("rezolus_bpf_run_time/cpu/usage") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("rezolus_bpf_run_time/memory/meminfo", LAG("rezolus_bpf_run_time/memory/meminfo") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
a_summed AS (
      SELECT timestamp, (COALESCE(val_0, 0)) AS v, 'cpu/usage' AS "sampler" FROM a_rates WHERE val_0 IS NOT NULL
      UNION ALL
      SELECT timestamp, (COALESCE(val_1, 0)) AS v, 'memory/meminfo' AS "sampler" FROM a_rates WHERE val_1 IS NOT NULL
),
b_rates AS (
  SELECT timestamp,
    irate_lag("rezolus_bpf_run_count/cpu/usage", LAG("rezolus_bpf_run_count/cpu/usage") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("rezolus_bpf_run_count/memory/meminfo", LAG("rezolus_bpf_run_count/memory/meminfo") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
b_summed AS (
      SELECT timestamp, (COALESCE(val_0, 0)) AS v, 'cpu/usage' AS "sampler" FROM b_rates WHERE val_0 IS NOT NULL
      UNION ALL
      SELECT timestamp, (COALESCE(val_1, 0)) AS v, 'memory/meminfo' AS "sampler" FROM b_rates WHERE val_1 IS NOT NULL
)
SELECT CAST(a.timestamp AS DOUBLE) / 1e9 AS t, (a.v / NULLIF(b.v, 0)) / 1000000000 AS v, a."sampler"
FROM a_summed a JOIN b_summed b ON a.timestamp = b.timestamp AND a."sampler" = b."sampler"

