=========================
histogram_heatmap_generic
=========================
WITH combined AS (
  SELECT timestamp, "request_latency:buckets" AS buckets, ROW_NUMBER() OVER (ORDER BY timestamp) AS rn FROM _src
),
per_tick AS (
  SELECT a.timestamp, h2_delta(a.buckets, b.buckets) AS d
  FROM combined a LEFT JOIN combined b ON b.rn = a.rn - 1
)
SELECT CAST(timestamp AS DOUBLE) / 1e9 AS t, (u.ordinal - 1)::INTEGER AS bucket_idx, u.value::DOUBLE AS count, 3::INTEGER AS p
FROM per_tick CROSS JOIN UNNEST(d) WITH ORDINALITY AS u(value, ordinal)
WHERE u.value > 0
ORDER BY t, bucket_idx

=========================
histogram_quantile_empty_period
=========================
WITH combined AS (
  SELECT timestamp, "request_latency:buckets" AS buckets, ROW_NUMBER() OVER (ORDER BY timestamp) AS rn FROM _src
),
per_tick AS (
  SELECT a.timestamp, h2_delta(a.buckets, b.buckets) AS d
  FROM combined a LEFT JOIN combined b ON b.rn = a.rn - 1
)
SELECT t, v FROM (
  SELECT CAST(timestamp AS DOUBLE) / 1e9 AS t, CAST(h2_quantile(d, 0.5, 3) AS DOUBLE) AS v
  FROM per_tick
)
WHERE v IS NOT NULL
ORDER BY t

=========================
histogram_quantile_generic
=========================
WITH combined AS (
  SELECT timestamp, "request_latency:buckets" AS buckets, ROW_NUMBER() OVER (ORDER BY timestamp) AS rn FROM _src
),
per_tick AS (
  SELECT a.timestamp, h2_delta(a.buckets, b.buckets) AS d
  FROM combined a LEFT JOIN combined b ON b.rn = a.rn - 1
)
SELECT t, v FROM (
  SELECT CAST(timestamp AS DOUBLE) / 1e9 AS t, CAST(h2_quantile(d, 0.5, 3) AS DOUBLE) AS v
  FROM per_tick
)
WHERE v IS NOT NULL
ORDER BY t

