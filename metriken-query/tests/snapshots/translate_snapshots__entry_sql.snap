      UNION ALL
      SELECT timestamp, (COALESCE(val_1, 0)) AS v, '1' AS "id" FROM b_rates WHERE val_1 IS NOT NULL
),
c_rates AS (
  SELECT timestamp,
    irate_lag("cpu_tsc/0", LAG("cpu_tsc/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("cpu_tsc/1", LAG("cpu_tsc/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
c_summed AS (
      SELECT timestamp, (COALESCE(val_0, 0)) AS v, '0' AS "id" FROM c_rates WHERE val_0 IS NOT NULL
      UNION ALL
      SELECT timestamp, (COALESCE(val_1, 0)) AS v, '1' AS "id" FROM c_rates WHERE val_1 IS NOT NULL
),
d_rates AS (
  SELECT timestamp,
    irate_lag("cpu_aperf/0", LAG("cpu_aperf/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("cpu_aperf/1", LAG("cpu_aperf/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
d_summed AS (
      SELECT timestamp, (COALESCE(val_0, 0)) AS v, '0' AS "id" FROM d_rates WHERE val_0 IS NOT NULL
      UNION ALL
      SELECT timestamp, (COALESCE(val_1, 0)) AS v, '1' AS "id" FROM d_rates WHERE val_1 IS NOT NULL
),
e_rates AS (
  SELECT timestamp,
    irate_lag("cpu_mperf/0", LAG("cpu_mperf/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("cpu_mperf/1", LAG("cpu_mperf/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
e_summed AS (
      SELECT timestamp, (COALESCE(val_0, 0)) AS v, '0' AS "id" FROM e_rates WHERE val_0 IS NOT NULL
      UNION ALL
      SELECT timestamp, (COALESCE(val_1, 0)) AS v, '1' AS "id" FROM e_rates WHERE val_1 IS NOT NULL
)
SELECT CAST(a.timestamp AS DOUBLE) / 1e9 AS t, ((a.v / NULLIF(b.v, 0) * c.v * d.v / NULLIF(e.v, 0)) / 1e9) AS v, a."id"
FROM a_summed a JOIN b_summed b ON a.timestamp = b.timestamp AND a."id" = b."id" JOIN c_summed c ON a.timestamp = c.timestamp AND a."id" = c."id" JOIN d_summed d ON a.timestamp = d.timestamp AND a."id" = d."id" JOIN e_summed e ON a.timestamp = e.timestamp AND a."id" = e."id"

