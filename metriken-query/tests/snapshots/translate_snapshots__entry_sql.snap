=========================
counter_ratio
=========================
WITH rates AS (
  SELECT timestamp,
    irate_lag("cpu_usage/user/0", LAG("cpu_usage/user/0") OVER w, timestamp - LAG(timestamp) OVER w) AS a_0,
    irate_lag("cpu_usage/user/1", LAG("cpu_usage/user/1") OVER w, timestamp - LAG(timestamp) OVER w) AS a_1,
    irate_lag("cpu_usage/user/0", LAG("cpu_usage/user/0") OVER w, timestamp - LAG(timestamp) OVER w) AS b_0,
    irate_lag("cpu_usage/system/0", LAG("cpu_usage/system/0") OVER w, timestamp - LAG(timestamp) OVER w) AS b_1,
    irate_lag("cpu_usage/softirq/0", LAG("cpu_usage/softirq/0") OVER w, timestamp - LAG(timestamp) OVER w) AS b_2,
    irate_lag("cpu_usage/irq/0", LAG("cpu_usage/irq/0") OVER w, timestamp - LAG(timestamp) OVER w) AS b_3,
    irate_lag("cpu_usage/user/1", LAG("cpu_usage/user/1") OVER w, timestamp - LAG(timestamp) OVER w) AS b_4,
    irate_lag("cpu_usage/system/1", LAG("cpu_usage/system/1") OVER w, timestamp - LAG(timestamp) OVER w) AS b_5,
    irate_lag("cpu_usage/softirq/1", LAG("cpu_usage/softirq/1") OVER w, timestamp - LAG(timestamp) OVER w) AS b_6,
    irate_lag("cpu_usage/irq/1", LAG("cpu_usage/irq/1") OVER w, timestamp - LAG(timestamp) OVER w) AS b_7
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
)
SELECT CAST(timestamp AS DOUBLE) / 1e9 AS t, ((CASE WHEN a_0 IS NOT NULL OR a_1 IS NOT NULL THEN (COALESCE(a_0, 0) + COALESCE(a_1, 0)) END) / NULLIF((CASE WHEN b_0 IS NOT NULL OR b_1 IS NOT NULL OR b_2 IS NOT NULL OR b_3 IS NOT NULL OR b_4 IS NOT NULL OR b_5 IS NOT NULL OR b_6 IS NOT NULL OR b_7 IS NOT NULL THEN (COALESCE(b_0, 0) + COALESCE(b_1, 0) + COALESCE(b_2, 0) + COALESCE(b_3, 0) + COALESCE(b_4, 0) + COALESCE(b_5, 0) + COALESCE(b_6, 0) + COALESCE(b_7, 0)) END), 0)) AS v
FROM rates

=========================
counter_ratio_by_g_with_labels
=========================
WITH
a_rates AS (
  SELECT timestamp,
    irate_lag("softirq_time/hi/0", LAG("softirq_time/hi/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("softirq_time/timer/0", LAG("softirq_time/timer/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1,
    irate_lag("softirq_time/net_rx/0", LAG("softirq_time/net_rx/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_2
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
a_summed AS (
      SELECT timestamp, (COALESCE(val_0, 0)) AS v, 'hi' AS "kind" FROM a_rates WHERE val_0 IS NOT NULL
      UNION ALL
      SELECT timestamp, (COALESCE(val_2, 0)) AS v, 'net_rx' AS "kind" FROM a_rates WHERE val_2 IS NOT NULL
      UNION ALL
      SELECT timestamp, (COALESCE(val_1, 0)) AS v, 'timer' AS "kind" FROM a_rates WHERE val_1 IS NOT NULL
),
b_rates AS (
  SELECT timestamp,
    irate_lag("softirq/hi/0", LAG("softirq/hi/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("softirq/timer/0", LAG("softirq/timer/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1,
    irate_lag("softirq/net_rx/0", LAG("softirq/net_rx/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_2
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
b_summed AS (
      SELECT timestamp, (COALESCE(val_0, 0)) AS v, 'hi' AS "kind" FROM b_rates WHERE val_0 IS NOT NULL
      UNION ALL
      SELECT timestamp, (COALESCE(val_2, 0)) AS v, 'net_rx' AS "kind" FROM b_rates WHERE val_2 IS NOT NULL
      UNION ALL
      SELECT timestamp, (COALESCE(val_1, 0)) AS v, 'timer' AS "kind" FROM b_rates WHERE val_1 IS NOT NULL
)
SELECT CAST(a.timestamp AS DOUBLE) / 1e9 AS t, (a.v / NULLIF(b.v, 0)) AS v, a."kind"
FROM a_summed a JOIN b_summed b ON a.timestamp = b.timestamp AND a."kind" = b."kind"

=========================
counter_ratio_by_id_complement
=========================
WITH
a_rates AS (
  SELECT timestamp,
    irate_lag("cpu_instructions/0", LAG("cpu_instructions/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("cpu_instructions/1", LAG("cpu_instructions/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
a_summed AS (
      SELECT timestamp, (COALESCE(val_0, 0)) AS v, '0' AS "id" FROM a_rates WHERE val_0 IS NOT NULL
      UNION ALL
      SELECT timestamp, (COALESCE(val_1, 0)) AS v, '1' AS "id" FROM a_rates WHERE val_1 IS NOT NULL
),
b_rates AS (
  SELECT timestamp,
    irate_lag("cpu_cycles/0", LAG("cpu_cycles/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("cpu_cycles/1", LAG("cpu_cycles/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
b_summed AS (
      SELECT timestamp, (COALESCE(val_0, 0)) AS v, '0' AS "id" FROM b_rates WHERE val_0 IS NOT NULL
      UNION ALL
      SELECT timestamp, (COALESCE(val_1, 0)) AS v, '1' AS "id" FROM b_rates WHERE val_1 IS NOT NULL
)
SELECT CAST(a.timestamp AS DOUBLE) / 1e9 AS t, ((1 - (a.v / NULLIF(b.v, 0)))) AS v, a."id"
FROM a_summed a JOIN b_summed b ON a.timestamp = b.timestamp AND a."id" = b."id"

=========================
counter_ratio_by_id_generic
=========================
WITH
a_rates AS (
  SELECT timestamp,
    irate_lag("cpu_instructions/0", LAG("cpu_instructions/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("cpu_instructions/1", LAG("cpu_instructions/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
a_summed AS (
      SELECT timestamp, (COALESCE(val_0, 0)) AS v, '0' AS "id" FROM a_rates WHERE val_0 IS NOT NULL
      UNION ALL
      SELECT timestamp, (COALESCE(val_1, 0)) AS v, '1' AS "id" FROM a_rates WHERE val_1 IS NOT NULL
),
b_rates AS (
  SELECT timestamp,
    irate_lag("cpu_cycles/0", LAG("cpu_cycles/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("cpu_cycles/1", LAG("cpu_cycles/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
b_summed AS (
      SELECT timestamp, (COALESCE(val_0, 0)) AS v, '0' AS "id" FROM b_rates WHERE val_0 IS NOT NULL
      UNION ALL
      SELECT timestamp, (COALESCE(val_1, 0)) AS v, '1' AS "id" FROM b_rates WHERE val_1 IS NOT NULL
)
SELECT CAST(a.timestamp AS DOUBLE) / 1e9 AS t, (a.v / NULLIF(b.v, 0)) AS v, a."id"
FROM a_summed a JOIN b_summed b ON a.timestamp = b.timestamp AND a."id" = b."id"

