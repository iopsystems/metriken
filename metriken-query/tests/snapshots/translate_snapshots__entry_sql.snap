=========================
rezolus_cpu_aperf_chain_per_id
=========================
WITH
a_rates AS (
  SELECT timestamp,
    irate_lag("cpu_tsc/0", LAG("cpu_tsc/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("cpu_tsc/1", LAG("cpu_tsc/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
a_summed AS (
      SELECT timestamp, (COALESCE(val_0, 0)) AS v, '0' AS "id" FROM a_rates WHERE val_0 IS NOT NULL
      UNION ALL
      SELECT timestamp, (COALESCE(val_1, 0)) AS v, '1' AS "id" FROM a_rates WHERE val_1 IS NOT NULL
),
b_rates AS (
  SELECT timestamp,
    irate_lag("cpu_aperf/0", LAG("cpu_aperf/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("cpu_aperf/1", LAG("cpu_aperf/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
b_summed AS (
      SELECT timestamp, (COALESCE(val_0, 0)) AS v, '0' AS "id" FROM b_rates WHERE val_0 IS NOT NULL
      UNION ALL
      SELECT timestamp, (COALESCE(val_1, 0)) AS v, '1' AS "id" FROM b_rates WHERE val_1 IS NOT NULL
),
c_rates AS (
  SELECT timestamp,
    irate_lag("cpu_mperf/0", LAG("cpu_mperf/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("cpu_mperf/1", LAG("cpu_mperf/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
c_summed AS (
      SELECT timestamp, (COALESCE(val_0, 0)) AS v, '0' AS "id" FROM c_rates WHERE val_0 IS NOT NULL
      UNION ALL
      SELECT timestamp, (COALESCE(val_1, 0)) AS v, '1' AS "id" FROM c_rates WHERE val_1 IS NOT NULL
)
SELECT CAST(a.timestamp AS DOUBLE) / 1e9 AS t, (a.v * b.v / NULLIF(c.v, 0)) AS v, a."id"
FROM a_summed a JOIN b_summed b ON a.timestamp = b.timestamp AND a."id" = b."id" JOIN c_summed c ON a.timestamp = c.timestamp AND a."id" = c."id"

=========================
rezolus_cpu_aperf_chain_total
=========================
WITH
a_rates AS (
  SELECT timestamp,
    irate_lag("cpu_tsc/0", LAG("cpu_tsc/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("cpu_tsc/1", LAG("cpu_tsc/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
a_summed AS (
      SELECT timestamp, (COALESCE(val_0, 0) + COALESCE(val_1, 0)) AS v FROM a_rates WHERE val_0 IS NOT NULL OR val_1 IS NOT NULL
),
b_rates AS (
  SELECT timestamp,
    irate_lag("cpu_aperf/0", LAG("cpu_aperf/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("cpu_aperf/1", LAG("cpu_aperf/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
b_summed AS (
      SELECT timestamp, (COALESCE(val_0, 0) + COALESCE(val_1, 0)) AS v FROM b_rates WHERE val_0 IS NOT NULL OR val_1 IS NOT NULL
),
c_rates AS (
  SELECT timestamp,
    irate_lag("cpu_mperf/0", LAG("cpu_mperf/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("cpu_mperf/1", LAG("cpu_mperf/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
c_summed AS (
      SELECT timestamp, (COALESCE(val_0, 0) + COALESCE(val_1, 0)) AS v FROM c_rates WHERE val_0 IS NOT NULL OR val_1 IS NOT NULL
),
cores AS (
  SELECT timestamp, CAST("cpu_cores" AS DOUBLE) AS v FROM _src
)
SELECT CAST(a.timestamp AS DOUBLE) / 1e9 AS t, ((a.v * b.v / NULLIF(c.v, 0)) / NULLIF(cores.v, 0)) AS v
FROM a_summed a JOIN b_summed b ON a.timestamp = b.timestamp JOIN c_summed c ON a.timestamp = c.timestamp JOIN cores cores ON a.timestamp = cores.timestamp

=========================
rezolus_cpu_busy_pct
=========================
WITH rates AS (
  SELECT timestamp,
    irate_lag("cpu_usage/user/0", LAG("cpu_usage/user/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("cpu_usage/system/0", LAG("cpu_usage/system/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1,
    irate_lag("cpu_usage/softirq/0", LAG("cpu_usage/softirq/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_2,
    irate_lag("cpu_usage/irq/0", LAG("cpu_usage/irq/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_3,
    irate_lag("cpu_usage/user/1", LAG("cpu_usage/user/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_4,
    irate_lag("cpu_usage/system/1", LAG("cpu_usage/system/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_5,
    irate_lag("cpu_usage/softirq/1", LAG("cpu_usage/softirq/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_6,
    irate_lag("cpu_usage/irq/1", LAG("cpu_usage/irq/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_7
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
)
SELECT CAST(timestamp AS DOUBLE) / 1e9 AS t, ((COALESCE(val_0, 0) + COALESCE(val_1, 0) + COALESCE(val_2, 0) + COALESCE(val_3, 0) + COALESCE(val_4, 0) + COALESCE(val_5, 0) + COALESCE(val_6, 0) + COALESCE(val_7, 0))) / 2000000000 AS v FROM rates WHERE val_0 IS NOT NULL OR val_1 IS NOT NULL OR val_2 IS NOT NULL OR val_3 IS NOT NULL OR val_4 IS NOT NULL OR val_5 IS NOT NULL OR val_6 IS NOT NULL OR val_7 IS NOT NULL

=========================
rezolus_cpu_ipns
=========================
WITH
a_rates AS (
  SELECT timestamp,
    irate_lag("cpu_instructions/0", LAG("cpu_instructions/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("cpu_instructions/1", LAG("cpu_instructions/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
a_summed AS (
      SELECT timestamp, (COALESCE(val_0, 0) + COALESCE(val_1, 0)) AS v FROM a_rates WHERE val_0 IS NOT NULL OR val_1 IS NOT NULL
),
b_rates AS (
  SELECT timestamp,
    irate_lag("cpu_cycles/0", LAG("cpu_cycles/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("cpu_cycles/1", LAG("cpu_cycles/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
b_summed AS (
      SELECT timestamp, (COALESCE(val_0, 0) + COALESCE(val_1, 0)) AS v FROM b_rates WHERE val_0 IS NOT NULL OR val_1 IS NOT NULL
),
c_rates AS (
  SELECT timestamp,
    irate_lag("cpu_tsc/0", LAG("cpu_tsc/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("cpu_tsc/1", LAG("cpu_tsc/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
c_summed AS (
      SELECT timestamp, (COALESCE(val_0, 0) + COALESCE(val_1, 0)) AS v FROM c_rates WHERE val_0 IS NOT NULL OR val_1 IS NOT NULL
),
d_rates AS (
  SELECT timestamp,
    irate_lag("cpu_aperf/0", LAG("cpu_aperf/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("cpu_aperf/1", LAG("cpu_aperf/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
d_summed AS (
      SELECT timestamp, (COALESCE(val_0, 0) + COALESCE(val_1, 0)) AS v FROM d_rates WHERE val_0 IS NOT NULL OR val_1 IS NOT NULL
),
e_rates AS (
  SELECT timestamp,
    irate_lag("cpu_mperf/0", LAG("cpu_mperf/0") OVER w, timestamp - LAG(timestamp) OVER w) AS val_0,
    irate_lag("cpu_mperf/1", LAG("cpu_mperf/1") OVER w, timestamp - LAG(timestamp) OVER w) AS val_1
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
),
e_summed AS (
      SELECT timestamp, (COALESCE(val_0, 0) + COALESCE(val_1, 0)) AS v FROM e_rates WHERE val_0 IS NOT NULL OR val_1 IS NOT NULL
),
cores AS (
  SELECT timestamp, CAST("cpu_cores" AS DOUBLE) AS v FROM _src
)
SELECT CAST(a.timestamp AS DOUBLE) / 1e9 AS t, ((a.v / NULLIF(b.v, 0) * c.v * d.v / NULLIF(e.v, 0)) / 1e9 / NULLIF(cores.v, 0)) AS v
FROM a_summed a JOIN b_summed b ON a.timestamp = b.timestamp JOIN c_summed c ON a.timestamp = c.timestamp JOIN d_summed d ON a.timestamp = d.timestamp JOIN e_summed e ON a.timestamp = e.timestamp JOIN cores cores ON a.timestamp = cores.timestamp

