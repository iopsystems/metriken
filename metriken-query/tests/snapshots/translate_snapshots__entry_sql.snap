=========================
counter_ratio_complement
=========================
WITH rates AS (
  SELECT timestamp,
    irate_lag("rezolus_bpf_run_count/cpu/usage", LAG("rezolus_bpf_run_count/cpu/usage") OVER w, timestamp - LAG(timestamp) OVER w) AS a_0,
    irate_lag("rezolus_bpf_run_count/memory/meminfo", LAG("rezolus_bpf_run_count/memory/meminfo") OVER w, timestamp - LAG(timestamp) OVER w) AS a_1,
    irate_lag("rezolus_bpf_run_time/cpu/usage", LAG("rezolus_bpf_run_time/cpu/usage") OVER w, timestamp - LAG(timestamp) OVER w) AS b_0,
    irate_lag("rezolus_bpf_run_time/memory/meminfo", LAG("rezolus_bpf_run_time/memory/meminfo") OVER w, timestamp - LAG(timestamp) OVER w) AS b_1
  FROM _src
  WINDOW w AS (ORDER BY timestamp)
)
SELECT CAST(timestamp AS DOUBLE) / 1e9 AS t, ((1 - ((CASE WHEN a_0 IS NOT NULL OR a_1 IS NOT NULL THEN (COALESCE(a_0, 0) + COALESCE(a_1, 0)) END) / NULLIF((CASE WHEN b_0 IS NOT NULL OR b_1 IS NOT NULL THEN (COALESCE(b_0, 0) + COALESCE(b_1, 0)) END), 0)))) AS v
FROM rates

